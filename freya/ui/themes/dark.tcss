/* Freya Dark Theme - Modern terminal UI */

Screen {
    background: $surface;
    color: $text;
}

Header {
    dock: top;
    height: 3;
    background: $primary;
    color: $text;
    content-align: center middle;
    text-style: bold;
}

Footer {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
}

Button {
    min-width: 16;
    height: 3;
    background: $primary;
    color: $text;
    border: solid $accent;
    content-align: center middle;
}

Button:hover {
    background: $primary-lighten-1;
    border: solid $accent-lighten-1;
}

Button:focus {
    border: double $accent;
}

Button.-primary {
    background: $success;
    border: solid $success-darken-1;
}

Button.-danger {
    background: $error;
    border: solid $error-darken-1;
}

Input {
    background: $surface;
    border: solid $accent;
    padding: 1 2;
    height: 3;
}

Input:focus {
    border: double $accent;
}

Select {
    background: $surface;
    border: solid $accent;
    height: 3;
}

Select:focus {
    border: double $accent;
}

TextArea {
    background: $surface;
    border: solid $accent;
    padding: 1;
}

TextArea:focus {
    border: double $accent;
}

Static {
    background: $surface;
    color: $text;
}

DataTable {
    background: $surface;
    height: 1fr;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent;
}

Tree {
    background: $surface;
    padding: 1;
}

Tree:focus > .tree--cursor {
    background: $accent;
}

LoadingIndicator {
    color: $accent;
}

/* Custom Classes */

.section-header {
    background: $primary;
    color: $text;
    text-style: bold;
    padding: 1 2;
    margin: 1 0;
}

.status-ok {
    color: $success;
    text-style: bold;
}

.status-warning {
    color: $warning;
    text-style: bold;
}

.status-error {
    color: $error;
    text-style: bold;
}

.status-pending {
    color: $text-muted;
}

.status-running {
    color: $accent;
}

/* Chat Styles */

.chat-user {
    background: $primary;
    color: $text;
    padding: 1 2;
    margin: 1 0;
    border: solid $primary-lighten-1;
}

.chat-assistant {
    background: $accent-darken-2;
    color: $text;
    padding: 1 2;
    margin: 1 0;
    border: solid $accent-darken-1;
}

.chat-system {
    background: $warning-darken-2;
    color: $text;
    padding: 1 2;
    margin: 1 0;
    border: solid $warning-darken-1;
}

.chat-metadata {
    color: $text-muted;
    text-style: italic;
    padding: 0 2;
}

/* Log Styles */

.log-debug {
    color: $text-muted;
}

.log-info {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-error {
    color: $error;
    text-style: bold;
}

/* Container Styles */

#sidebar {
    width: 30;
    background: $panel;
    border-right: solid $accent;
}

#content {
    width: 1fr;
    background: $surface;
}

#filters {
    height: auto;
    background: $panel;
    padding: 1;
    border-bottom: solid $accent;
}

#chat-history {
    height: 1fr;
    background: $surface;
    border: solid $accent;
}

#input-area {
    height: auto;
    background: $panel;
    padding: 1;
}

/* Utility Classes */

.center {
    content-align: center middle;
}

.bold {
    text-style: bold;
}

.italic {
    text-style: italic;
}

.hidden {
    display: none;
}
