# Freya Environment Variables
# Copy this file to .env and fill in your values

# ElevenLabs API Key
# Get yours from: https://elevenlabs.io/app/settings
ELEVENLABS_API_KEY=your_api_key_here

# ElevenLabs Voice ID (optional - defaults to Rachel)
# Browse voices: https://elevenlabs.io/app/voice-library
# Popular options:
#   21m00Tcm4TlvDq8ikWAM - Rachel (calm, clear female) - DEFAULT
#   AZnzlk1XvdvUeBnXmlld - Domi (strong, confident female)
#   EXAVITQu4vr4xnSDxMaL - Bella (soft, warm female)
#   ErXwobaYiN019PkySvjV - Antoni (well-rounded male)
#   TxGEqnHWrfWFTfGW9XjX - Josh (deep, authoritative male)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs Model (optional - defaults to turbo_v2_5)
# Options: eleven_turbo_v2_5 (fast) or eleven_multilingual_v2 (quality)
ELEVENLABS_MODEL=eleven_turbo_v2_5
