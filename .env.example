# Freya AI Assistant - Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to git - it contains secrets!

# ===================================
# ElevenLabs TTS (Cloud)
# ===================================
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_api_key_here

# Optional: Override voice ID (default in config.yaml)
# ELEVENLABS_VOICE_ID=AXdMgz6evoL7OPd7eU12

# Optional: Override TTS model (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# ===================================
# Ollama LLM Server
# ===================================
# Optional: Override Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional: Override model name (default in config.yaml)
# OLLAMA_MODEL=dolphin3:8b

# ===================================
# Audio Configuration
# ===================================
# Optional: Override microphone device index
# AUDIO_INPUT_DEVICE=0

# Optional: Override speaker device index
# AUDIO_OUTPUT_DEVICE=0

# ===================================
# Memory/Database
# ===================================
# Optional: Override database path (default: data/freya_memory.db)
# MEMORY_DB_PATH=data/freya_memory.db

# Optional: ChromaDB persistence directory
# CHROMA_PERSIST_DIR=data/chroma_db

# ===================================
# Development/Debug
# ===================================
# Optional: Enable debug logging (default: false)
# DEBUG=false

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
